<?xml version="1.0" encoding="utf-8"?>
<!-- Used when the site runs on Windows IIS hosting (for example SmarterASP.NET). Publish fills in processPath and arguments. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Sumlers.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- IIS stops uploads at 30 MB by default; a backup zip with photos can be larger. Matches BackupService.MaxImportBytes. -->
          <requestLimits maxAllowedContentLength="1073741824" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
